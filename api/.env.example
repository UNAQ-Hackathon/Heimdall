NODE_ENV=development
PORT=5000

# MongoDB Atlas (or local mongod / docker-compose)
MONGODB_URI=mongodb://localhost:27017/heimdall

# Devin API — SWE model (summaries / chat)
DEVIN_API_KEY=
DEVIN_API_BASE=https://api.devin.ai
DEVIN_MODEL=swe-2-medium

# FastAPI analytics engine
ANALYTICS_API_URL=http://localhost:8000

# Allowed frontend origins (comma-separated)
CORS_ORIGIN=http://localhost:5173
