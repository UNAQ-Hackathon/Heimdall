NODE_ENV=development
PORT=5000

# MongoDB Atlas (or local mongod / docker-compose)
MONGODB_URI=mongodb://localhost:27017/heimdall

# AI provider chain — 'auto' tries gemini → openai-compat → devin.
# Set to 'gemini' | 'openai' | 'devin' to force a single provider.
AI_PROVIDER=auto
# Tight per-response cap for FireHazR interpretations (saves quota)
AI_INTERPRET_MAX_TOKENS=320

# Google AI Studio Gemini (free tier: ~5 RPM — easy to exhaust in demos)
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TOKEN_LIMIT=60000
GEMINI_MAX_OUTPUT_TOKENS=512

# Any OpenAI-compatible endpoint — Groq free tier works well:
#   OPENAI_COMPAT_API_KEY=<gsk_...>  (console.groq.com)
#   defaults point at Groq + gpt-oss-120b (~30 RPM / 8K TPM free)
# OpenRouter: apiBase=https://openrouter.ai/api/v1  model=meta-llama/llama-3.3-70b-instruct
# Ollama local: apiBase=http://localhost:11434/v1  model=llama3.3  (key can be any non-empty string)
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_API_BASE=https://api.groq.com/openai/v1
OPENAI_COMPAT_MODEL=openai/gpt-oss-120b
OPENAI_COMPAT_TOKEN_LIMIT=60000
OPENAI_COMPAT_MAX_OUTPUT_TOKENS=512
# 'low' keeps reasoning models (gpt-oss/qwen3) inside tight token caps; '' disables
OPENAI_COMPAT_REASONING_EFFORT=low

# Devin API — SWE model (summaries / chat)
DEVIN_API_KEY=
DEVIN_API_BASE=https://api.devin.ai
DEVIN_MODEL=swe-2-medium

# FastAPI analytics engine
ANALYTICS_API_URL=http://localhost:8000

# Allowed frontend origins (comma-separated)
CORS_ORIGIN=http://localhost:5173
